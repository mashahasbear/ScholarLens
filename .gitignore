# -----------------------------
# Environment variables
# -----------------------------
.env
.env.*
!.env.example

# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/

# Python build files
build/
dist/
*.egg-info/

# -----------------------------
# Databases
# -----------------------------
*.db
*.sqlite
*.sqlite3

# -----------------------------
# Uploaded and generated files
# -----------------------------
data/uploads/
data/processed/
data/exports/
*.pdf

# Keep empty data directories
!data/.gitkeep

# -----------------------------
# Frontend
# -----------------------------
node_modules/
frontend/dist/
frontend/.vite/

# -----------------------------
# IDE and operating system
# -----------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# -----------------------------
# Logs
# -----------------------------
*.log
logs/New-Item data\.gitkeep -ItemType File